# ─────────────────────────────────────────────────────────────────────────────
# OG Sports Club — environment variables
# Copy to `.env` for local development. On Render, set these in the dashboard
# (render.yaml already declares them). NEVER commit a real .env file.
# Variables starting with VITE_ are bundled into the browser app — only put
# PUBLIC values there. Everything else stays on the server.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server
NODE_ENV=development
PORT=4000
# Public URL of the site (used for Clerk authorized parties). e.g. https://ogsports.onrender.com
PUBLIC_URL=http://localhost:5173
# Club time zone — all opening hours and booking times use this.
CLUB_TIMEZONE=Asia/Kolkata
# Only needed if the frontend is hosted on a different origin than the API (comma separated)
CORS_ORIGINS=

# ── Database (PostgreSQL 14+)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/og_sports
# true for external/managed connections that require SSL; Render's *internal* URL works with false.
DATABASE_SSL=false
DATABASE_POOL_MAX=10
# Apply migrations automatically when the server starts (safe to run repeatedly).
RUN_MIGRATIONS_ON_START=true
# Local only: add demo customers/bookings on first run. Ignored in production.
SEED_DEMO_DATA=false

# ── Authentication (Clerk — https://dashboard.clerk.com → API Keys)
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Publishable key — used by the browser (VITE_) and by the server.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Comma-separated emails that become admins automatically when they sign in.
ADMIN_EMAILS=owner@yourclub.com

# Local development without Clerk: set DEV_AUTH=true and leave the Clerk keys empty.
# The server REFUSES to start if this is enabled with NODE_ENV=production.
DEV_AUTH=false

# ── Payments (Razorpay — https://dashboard.razorpay.com → Settings → API Keys)
# razorpay (real payments, UPI/cards/netbanking) | venue (no online payment — confirmed at once, paid at the club)
# | mock (local testing only, blocked in production)
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Settings → Webhooks → add https://YOUR-DOMAIN/api/webhooks/razorpay with a secret
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# ── Frontend (optional)
# Leave empty when the API and site share a domain (the default Render setup).
VITE_API_URL=
